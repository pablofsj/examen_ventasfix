# Este archivo es solo referencia. El proyecto genera `.env` automáticamente
# al ejecutar `npm install` (scripts/setup-env.js), incluyendo un JWT_SECRET
# aleatorio seguro. No necesitas crearlo manualmente.

# Conexión a PostgreSQL embebido (credenciales del enunciado, puerto 5433)
DATABASE_URL="postgresql://root:ventasfix@localhost:5433/ventasfix"

# Clave para firmar/verificar los JWT (se genera automáticamente en .env)
JWT_SECRET="genera-un-secreto-de-32-bytes"
